@using CaldovaOrderManagement.Web.Data
@model IReadOnlyList<ProductRow>
<div class="table-wrap">
<table>
    <thead><tr><th>SKU</th><th>Product</th><th>Category</th><th class="num">Unit price</th><th class="num">Available</th><th>Stock</th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Sku</td>
            <td>@p.Name @if (!p.IsActive) { <span class="badge neutral">Inactive</span> }</td>
            <td>@p.Category</td>
            <td class="num">@p.UnitPrice.ToString("C2")</td>
            <td class="num">@p.Available</td>
            <td><span class="badge @p.StockCss">@p.StockState</span></td>
        </tr>
    }
    </tbody>
</table>
</div>
