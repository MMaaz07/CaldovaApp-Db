@page
@model CaldovaOrderManagement.Web.Pages.SearchModel
@{ ViewData["Title"] = "Traditional SQL Search"; }

<h1>Traditional SQL Search</h1>
<p class="lead">Keyword search using SQL <code>LIKE</code> on the medicine name only. Matching is literal; there is no semantic or synonym matching.</p>

<div class="card">
    <form method="get" class="inline" onsubmit="this.classList.add('busy')">
        <div>
            <label for="q">Keyword</label>
            <input id="q" name="q" class="wide" maxlength="100" value="@Model.Q" placeholder="e.g. Paracetamol, Dolo 650" />
        </div>
        <button type="submit">Search</button>
    </form>
    <div class="loading">Searching…</div>
    @if (Model.ValidationError != null) { <div class="field-error">@Model.ValidationError</div> }
</div>

@if (Model.Error != null)
{
    <div class="alert error">@Model.Error</div>
}
else if (Model.Results != null)
{
    @if (Model.Results.Count == 0)
    {
        <div class="card empty">No products found matching “@Model.Q”.</div>
    }
    else
    {
        <p class="muted">@Model.Results.Count result(s) for “@Model.Q”</p>
        <div class="card"><partial name="_ProductTable" model="Model.Results" view-data='new ViewDataDictionary(ViewData) { { "ShowCategory", false } }' /></div>
    }
}
